    "server.json": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "AI trading agent for Hyperliquid: exact stop and target on every order. Mainnet; testnet opt-in.",
      "name": "io.github.Julian-dev28/pathiel",
      "packages": [
        {
          "environmentVariables": [
            {
              "choices": [
                "mainnet",
                "testnet"
              ],
              "default": "mainnet",
              "description": "Hyperliquid network: mainnet (the default; real money once a key is set) or testnet (test funds).",
              "isRequired": false,
              "isSecret": false,
              "name": "PATHIEL_NETWORK"
            }
          ],
          "identifier": "ghcr.io/julian-dev28/pathiel-mcp:0.7.1",
          "registryType": "oci",
          "runtimeArguments": [
            {
              "description": "Keep stdin open: the server speaks MCP over stdio.",
              "name": "-i",
              "type": "named"
            },
            {
              "description": "Remove the container when the client disconnects.",
              "name": "--rm",
              "type": "named"
            },
            {
              "description": "Mount the folder that holds your pathiel env file, config and state.",
              "isRequired": true,
              "name": "-v",
              "type": "named",
              "value": "{pathiel_home}:/data",
              "variables": {
                "pathiel_home": {
                  "description": "Absolute path to your pathiel folder, usually ~/.pathiel. Keys stay in its .env.local and never go in this config.",
                  "format": "filepath",
                  "isRequired": true
                }
              }
            }
          ],
          "runtimeHint": "docker",
          "transport": {
            "type": "stdio"
          }
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/Julian-dev28/pathiel"
      },
      "title": "pathiel",
      "version": "0.7.1",
      "websiteUrl": "https://github.com/Julian-dev28/pathiel#before-you-trade"
    }
