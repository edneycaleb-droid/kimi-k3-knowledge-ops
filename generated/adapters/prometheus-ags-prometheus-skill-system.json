  "mcp_manifests": {
    ".mcp.json": {
      "mcpServers": {
        "forge-rs": {
          "description": "Layer 4 code-enrichment engine \u2014 forge_enrich, forge_reflect, forge_drift, forge_validate",
          "headers": {
            "Authorization": "Bearer ${FORGE_MCP_TOKEN:-forge-mcp-local-dev-30dfefcc32263a0813ffdbd2}"
          },
          "type": "http",
          "url": "${FORGE_MCP_URL:-http://localhost:8943/mcp}"
        },
        "liter-llm": {
          "args": [
            "mcp",
            "--transport",
            "stdio",
            "--config",
            "${LITER_LLM_CONFIG:-/Users/gqadonis/.config/liter-llm/liter-llm-proxy.toml}"
          ],
          "command": "liter-llm",
          "description": "Multi-model routing proxy \u2014 22 MCP tools across 140+ providers with per-phase model class routing (default config routes through the local openai-proxy at :8181)"
        },
        "prometheus-knowledge": {
          "description": "Karpathy LLM Knowledge Base \u2014 knowledge_ingest, knowledge_focus, knowledge_search, knowledge_lint, knowledge_get",
          "type": "http",
          "url": "${PK_MCP_URL:-http://localhost:8942/mcp}"
        },
        "sequential-thinking": {
          "args": [
            "-y",
            "@modelcontextprotocol/server-sequential-thinking"
          ],
          "command": "npx"
        },
        "surreal-memory": {
          "description": "Global distributed memory state server \u2014 knowledge graph, scoped memory, TaskStreams, mindmaps, Graph-RAG traversal, hybrid search",
          "type": "sse",
          "url": "${SURREAL_MEMORY_URL:-http://localhost:23001/mcp/sse}"
        },
        "sycophancy-correction": {
          "command": "sycophancy-correction",
          "description": "Detect and correct sycophantic patterns (S-01 through S-08) in prompts, completions, agent descriptors, and PMPO reflect outputs"
        },
        "tavily": {
          "args": [
            "-y",
            "tavily-mcp"
          ],
          "command": "npx",
          "env": {
            "TAVILY_API_KEY": "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"
          }
        }
      }
    }
  },
