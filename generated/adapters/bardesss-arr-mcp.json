  "mcp_manifests": {
    "server.json": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "One server, 44 tools, the whole media stack: *arrs, Jellyfin, Plex, Seerr, Cleanuparr, downloaders",
      "icons": [
        {
          "mimeType": "image/svg+xml",
          "sizes": [
            "any"
          ],
          "src": "https://raw.githubusercontent.com/bardesss/arr-mcp/main/assets/logo.svg"
        }
      ],
      "name": "io.github.bardesss/arr-mcp",
      "packages": [
        {
          "environmentVariables": [
            {
              "default": "1000",
              "description": "User id owning the files in /config",
              "name": "PUID"
            },
            {
              "default": "1000",
              "description": "Group id owning the files in /config",
              "name": "PGID"
            },
            {
              "description": "Timezone used for timestamps, e.g. Europe/Amsterdam",
              "name": "TZ"
            }
          ],
          "identifier": "ghcr.io/bardesss/arr-mcp:latest",
          "registryType": "oci",
          "runtimeArguments": [
            {
              "description": "Publish the MCP and config-UI port",
              "name": "-p",
              "type": "named",
              "value": "6060:6060"
            },
            {
              "description": "Host directory holding config.yaml, the write audit and the log ring buffer",
              "isRequired": true,
              "name": "-v",
              "type": "named",
              "value": "{config_dir}:/config",
              "variables": {
                "config_dir": {
                  "description": "Directory on the host to keep arr-mcp's configuration in",
                  "format": "filepath",
                  "isRequired": true
                }
              }
            }
          ],
          "runtimeHint": "docker",
          "transport": {
            "headers": [
              {
                "description": "An MCP token, created on the arr-mcp config page (shown once)",
                "isRequired": true,
                "isSecret": true,
                "name": "Authorization",
                "value": "Bearer {token}",
                "variables": {
                  "token": {
                    "description": "An MCP token, created on the arr-mcp config page at http://<host>:6060 (shown once)",
                    "isRequired": true,
                    "isSecret": true
                  }
                }
              }
            ],
            "type": "streamable-http",
            "url": "http://localhost:6060/mcp"
          }
        }
      ],
      "repository": {
        "id": "1322956288",
        "source": "github",
        "url": "https://github.com/bardesss/arr-mcp"
      },
