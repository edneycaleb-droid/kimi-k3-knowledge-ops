  "mcp_manifests": {
    "server.json": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "Calibre ebook library server: search, read content, curate metadata, semantic search, gated writes.",
      "name": "io.github.caelum29/calibre-mcp",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Calibre Content Server base URL (default http://localhost:8080)",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "CALIBRE_MCP_SERVER_URL"
            },
            {
              "description": "Library name; empty = auto-detect the server's default library",
              "format": "string",
              "isRequired": false,
              "isSecret": false,
              "name": "CALIBRE_MCP_LIBRARY"
            },
            {
              "description": "Set to 1 to enable the write tools (update/bulk-update/add/remove); off by default",
              "format": "boolean",
              "isRequired": false,
              "isSecret": false,
              "name": "CALIBRE_MCP_ENABLE_WRITE"
            },
            {
              "description": "Path to the calibredb binary; empty = auto-discover the standard install location",
              "format": "filepath",
              "isRequired": false,
              "isSecret": false,
              "name": "CALIBRE_MCP_CALIBREDB_PATH"
            }
          ],
          "identifier": "calibre-mcp",
          "registryType": "npm",
          "transport": {
            "type": "stdio"
          },
          "version": "0.12.0"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/caelum29/calibre-mcp"
      },
      "version": "0.12.0"
