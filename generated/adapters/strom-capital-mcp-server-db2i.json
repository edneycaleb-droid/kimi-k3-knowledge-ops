  "mcp_manifests": {
    "server.json": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "description": "Read-only SQL queries and schema inspection for IBM Db2 for i over ODBC, JT400 or Mapepire (SSH).",
      "name": "io.github.Strom-Capital/mcp-server-db2i",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "IBM i hostname or IPv4 address",
              "isRequired": true,
              "name": "DB2I_HOSTNAME",
              "placeholder": "ibmi.example.com"
            },
            {
              "description": "IBM i user profile",
              "isRequired": true,
              "name": "DB2I_USERNAME"
            },
            {
              "description": "IBM i password",
              "isRequired": true,
              "isSecret": true,
              "name": "DB2I_PASSWORD"
            },
            {
              "description": "Default schema (library)",
              "name": "DB2I_SCHEMA",
              "placeholder": "MYLIB"
            },
            {
              "description": "Path to a YAML file of IBM i systems. When set, it replaces the DB2I_* connection variables",
              "name": "DB2I_PROFILES"
            },
            {
              "description": "Comma-separated schemas the server may read. Empty disables the check.",
              "name": "QUERY_ALLOWED_SCHEMAS",
              "placeholder": "MYLIB,OTHERLIB"
            },
            {
              "default": "odbc",
              "description": "Database driver: odbc (default, IBM i Access ODBC driver, no Java), jt400 (optional node-jt400 package, needs a JDK at install and a JRE at runtime) or mapepire (Mapepire over SSH, needs Java on the IBM i only)",
              "isRequired": false,
              "name": "DB2I_DRIVER"
            },
            {
              "description": "Extra JT400 JDBC properties, semicolon-separated (jt400 and mapepire drivers)",
              "isRequired": false,
              "name": "DB2I_JDBC_OPTIONS"
            },
            {
              "description": "Extra IBM i Access ODBC connection keywords, semicolon-separated (odbc driver)",
              "isRequired": false,
              "name": "DB2I_ODBC_OPTIONS"
            },
            {
              "description": "SSH and Mapepire settings, semicolon-separated, e.g. hostKey=SHA256:...;maxJobs=2 (mapepire driver)",
              "isRequired": false,
              "name": "DB2I_MAPEPIRE_OPTIONS"
            }
          ],
          "identifier": "mcp-server-db2i",
          "registryType": "npm",
          "transport": {
            "type": "stdio"
          },
          "version": "2.12.0"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/Strom-Capital/mcp-server-db2i"
      },
      "title": "IBM Db2 for i",
      "version": "2.12.0",
      "websiteUrl": "https://db2i-mcp.com"
    }
  },
